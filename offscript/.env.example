# Copy this file to a new file called ".env" and fill in your own values.
# (See docs/SETUP_GUIDE.md — steps 3 and 8c.)

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-the-anon-public-key-here

# Optional: where businesses can email you about sponsoring Offscript.
# Leave blank to hide the "sponsor offscript" link on the Me screen.
EXPO_PUBLIC_SPONSOR_EMAIL=
