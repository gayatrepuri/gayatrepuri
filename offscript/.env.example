# Copy this file to a new file called ".env" and fill in your own values.
# (See docs/SETUP_GUIDE.md — steps 3 and 8.)

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-the-anon-public-key-here

# RevenueCat → Project → API keys (leave blank until you set up payments)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
