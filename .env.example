# Copy this file to ".env.local" and fill in the values.
# ".env.local" is never uploaded to GitHub.

# Supabase → Project Settings → Data API (Project URL)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys → "Publishable key" (or the legacy "anon public" key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Anthropic → console.anthropic.com → API Keys. Server-side only.
ANTHROPIC_API_KEY=
# The Claude model used for analysis.
ANTHROPIC_MODEL=claude-opus-5-5
